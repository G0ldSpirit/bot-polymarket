# Polymarket Trading Bot Configuration
# Copy this file to .env and fill in your values

# ===========================================
# WALLET CONFIGURATION (REQUIRED)
# ===========================================

# Your Ethereum private key (without 0x prefix)
# WARNING: Keep this secret and never share it!
PRIVATE_KEY=your_private_key_here

# ===========================================
# API CONFIGURATION
# ===========================================

# Polymarket API endpoints
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137

# ===========================================
# TRADING CONFIGURATION
# ===========================================

# Maximum amount in USDC per trade
MAX_TRADE_AMOUNT=100

# Minimum profit percentage to trigger a trade
MIN_PROFIT_PERCENTAGE=2.0

# Maximum number of open positions
MAX_OPEN_POSITIONS=5

# Stop loss percentage (e.g., 10 = sell if down 10%)
STOP_LOSS_PERCENTAGE=10

# Take profit percentage (e.g., 20 = sell if up 20%)
TAKE_PROFIT_PERCENTAGE=20

# ===========================================
# BOT SETTINGS
# ===========================================

# Trading interval in seconds
TRADING_INTERVAL=60

# Enable dry run mode (no real trades)
DRY_RUN=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
